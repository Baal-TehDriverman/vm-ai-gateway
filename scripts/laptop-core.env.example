# ═══ NSSP Core Node Configuration — Laptop (tehlappy) ═══
# Copy this to ~/.nssp/nssp-core.env and edit values
# This file is sourced by the laptop setup script and all NSSP services

# ─── Device Identity ───
DEVICE_NAME="tehlappy-core"
DEVICE_ROLE="laptop"              # laptop = heavy tasks
DEVICE_ARCH="x86_64"

# ─── Services ───
GATEWAY_PORT="8080"               # Lilith Gateway
WIN_CONSOLE_PORT="8081"           # Windows Port Console
DASH_PORT="3000"                  # Unified Dashboard
OLLAMA_PORT="11434"               # Ollama

# ─── Ollama ───
OLLAMA_URL="http://localhost:11434"

# ─── vLLM (laptop only — NOT on phones) ───
VLLM_HOST="0.0.0.0"
VLLM_PORT="8000"

# ─── Models ───
GEMMA3_MODEL="gemma3:1b"
COSMOS_MODEL="cosmos-3-quantized"
DEFAULT_MODEL="gemma3-1b-jailbreak"
FALLBACK_MODEL="gemma3:1b"

# ─── GitHub Mesh ───
# Generate at: https://github.com/settings/tokens (needs: repo, read:org, workflow)
GITHUB_TOKEN=""
MESH_REPO="Baal-TehDriverman/lilith-nssp-mesh"
MESH_POLL_INTERVAL="30"           # Seconds between poll cycles

# ─── Hermes Agent ───
HERMES_CONFIG_DIR="$HOME/.hermes"

# ─── Paths ───
NSSP_DIR="$HOME/nssp-core"
MESH_DIR="$HOME/nssp-core/lilith-nssp-mesh"
GATEWAY_DIR="$HOME/nssp-core/vm-ai-gateway/lilith-gateway"
WIN_CONSOLE_DIR="$HOME/nssp-core/vm-ai-gateway/windows-port-console"
DASH_DIR="$HOME/nssp-core/vm-ai-gateway/unified-dashboard"
HERMES_DIR="$HOME/nssp-core/hermes-agent"

# ─── GPU ───
# RTX 3060 6GB VRAM — quantized models only for local inference
GPU_MEMORY_LIMIT_MB="6144"
CUDA_VISIBLE_DEVICES="0"

# ─── NSSP Kernel (optional — for custom kernel build) ───
# See: https://github.com/Baal-TehDriverman/nssp-kernel
# Kernel: linux-zen, systemd-boot UKI, Btrfs+LUKS2
# Build: cd nssp-build && ./build.sh
NSSP_KERNEL_ENABLED="false"
